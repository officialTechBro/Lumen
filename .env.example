# Neon PostgreSQL — dev branch connection string
# IMPORTANT: Use the DIRECT connection string (no "-pooler" in the hostname).
# The pooler URL only supports HTTP/WebSocket; Prisma migrations and the pg driver need raw TCP.
# Find this in your Neon dashboard → Connection Details → toggle off "Connection pooling"
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Email verification — set to "false" to bypass during dev (Resend sandbox only allows verified addresses)
# Leave unset or set to "true" for production behaviour (verification required)
REQUIRE_EMAIL_VERIFICATION=true

# Upstash Redis — required for rate limiting on auth endpoints
# Create a free database at https://console.upstash.com and copy the REST credentials
UPSTASH_REDIS_REST_URL="https://cool-crab-124611.upstash.io"
UPSTASH_REDIS_REST_TOKEN="gQAAAAAAAebDAAIgcDI1NzlhMjM3ZDQ5YTg0ZWVkYjAwNzM3ZTU4ZDBiNDljMg"



